# Readback recovery changes no live arm or alert-contract gates.
READBACK_AUTO_RECOVERY_ENABLED=true
READBACK_AUTO_RECOVERY_INTERVAL_SECONDS=10
READBACK_AUTO_RECOVERY_CONFIRMATIONS=2
CROSSTRADE_BASE_URL=https://app.crosstrade.io
CROSSTRADE_TOKEN=
AUTOPROP_WEBHOOK_TOKEN=
SQLITE_PATH=/data/autoprop_router_v123.sqlite3
SHADOW_SQLITE_PATH=/data/autoprop_router_shadow.sqlite3
SHADOW_BROKER_READS_ENABLED=false
ACCOUNT_CONFIG_PATH=/data/accounts.json
ACCOUNT_CONFIG_JSON=
RISK_STATE_JSON=
AUTO_DISCOVERY=true
FUNDEDNEXT_DEFAULT_MODEL=Legacy
AUTO_ONBOARD_VERIFIED_CHALLENGE_COHORTS=true
AUTO_ONBOARD_FUNDEDNEXT_LEGACY_CHALLENGES=true
AUTO_DISCOVERY_INTERVAL_SECONDS=10
AUTO_ONBOARD_BALANCE_TOLERANCE=1
AUTO_ONBOARD_FILL_LOOKBACK_DAYS=35
STATE_POLL_SECONDS=10
MAX_STATE_AGE_SECONDS=20
REQUEST_TIMEOUT_SECONDS=6
CROSSTRADE_REQUEST_MIN_INTERVAL_SECONDS=0.10
CROSSTRADE_MUTATION_MIN_INTERVAL_SECONDS=0.02
CROSSTRADE_SAFE_GET_MAX_CONCURRENCY=2
CROSSTRADE_GET_RETRY_MAX_RETRIES=3
CROSSTRADE_GET_RETRY_DELAY_SECONDS=0.75
CROSSTRADE_GET_RETRY_BACKOFF_MULTIPLIER=2.0
CROSSTRADE_GET_RETRY_MAX_DELAY_SECONDS=5.0
DEFAULT_EXECUTION_SYMBOL=MNQ1!
MNQ_POINT_VALUE=2.0
MNQ_TICK_SIZE=0.25
MODELED_ROUND_TRIP_COST=2.90
CONSISTENCY_MIN_PROFIT_ROOM=50
USE_CROSSTRADE_POSITION_GATE=true
USE_CROSSTRADE_MAX_POSITIONS_GATE=false
AUTOPROP_EXECUTION_MODE=shadow
AUTOPROP_MANAGEMENT_MODE=exact_formula_parity
LIVE_MAX_QTY_PER_ACCOUNT=0
NATIVE_ATM_BREAKEVEN_AFTER_TP1=false
EXECUTION_REQUIRE_PROTECTIVE_STOP=true
MANAGEMENT_CHANGE_RETRIES=3
MANAGEMENT_CHANGE_RETRY_DELAY_SECONDS=0.25
BRACKET_CONFIRM_RETRIES=12
BRACKET_CONFIRM_RETRY_DELAY_SECONDS=0.25
ENTRY_SIGNAL_MAX_AGE_SECONDS=8
ENTRY_PREFLIGHT_TIMEOUT_SECONDS=5
ENTRY_FANOUT_MAX_CONCURRENCY=16
ENTRY_RECONCILE_TIMEOUT_SECONDS=90
CORE_NORMALIZATION_MAX_CONCURRENCY=16
ENTRY_RECONCILE_BASE_DELAY_SECONDS=0.75
ENTRY_RECONCILE_MAX_DELAY_SECONDS=5
ENTRY_RECONCILE_LOOP_SECONDS=0.50
SILVER_MANAGEMENT_LOOP_SECONDS=0.25
SILVER_MANAGEMENT_RETRY_BASE_SECONDS=0.50
SILVER_MANAGEMENT_RETRY_MAX_SECONDS=5
ENTRY_STATE_CACHE_MAX_AGE_SECONDS=20
STARTUP_STATE_WARM_TIMEOUT_SECONDS=20
# Bounded conservative sizing for transient state-read outages. These defaults allow
# five signal waves or one hour, whichever comes first. Auth/config/account-status
# failures remain fail-closed. Omit these variables in Railway to use the defaults.
STATE_FALLBACK_ENABLED=true
STATE_FALLBACK_MAX_ENTRY_WAVES=5
STATE_FALLBACK_MAX_DURATION_SECONDS=3600
STATE_FALLBACK_CHALLENGE_MAX_LOSS_PCT=10
STATE_FALLBACK_FUNDED_MAX_LOSS_PCT=7.5
STATE_FALLBACK_PERSONAL_RISK_MULTIPLIER=0.5
DEDUPE_RETENTION_DAYS=30
# Live arms are deliberately blank in the shadow-observer deployment.
AUTOPROP_LIVE_ARM=
AUTOPROP_FULL_SCALE_ARM=
TRADINGVIEW_ALERT_CONTRACT_VERIFIED=false

# CrossTrade rate-limit hardening (v1.2.5 defaults; optional overrides)
CROSSTRADE_RATE_LIMIT_PER_MINUTE=150
CROSSTRADE_RATE_LIMIT_WINDOW_SECONDS=60
CROSSTRADE_RATE_LIMIT_MAX_RETRIES=8
CROSSTRADE_RATE_LIMIT_FALLBACK_SECONDS=1

# Asia Sweep working-limit reconciliation
ASW_PENDING_RECONCILE_SECONDS=10
ASW_PROTECTION_CONFIRM_RETRIES=4
ASW_PROTECTION_CONFIRM_RETRY_DELAY_SECONDS=0.25
