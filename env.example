# CrossTrade API
CROSSTRADE_BASE_URL=https://app.crosstrade.io
CROSSTRADE_TOKEN=REPLACE_ME

# Put a long random token in the TradingView webhook URL:
# https://YOUR-ROUTER/webhook/tradingview/<THIS_TOKEN>
AUTOPROP_WEBHOOK_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE

# SAFE DEFAULT. "shadow" NEVER submits a broker order.
AUTOPROP_EXECUTION_MODE=shadow

# Live requires BOTH:
# AUTOPROP_EXECUTION_MODE=live
# AUTOPROP_LIVE_ARM=I_UNDERSTAND_LIVE_ORDERS
AUTOPROP_LIVE_ARM=

# Account state is refreshed OUTSIDE the alert execution path.
STATE_POLL_SECONDS=10
MAX_STATE_AGE_SECONDS=20
REQUEST_TIMEOUT_SECONDS=4

# Use the actual front-month Tradovate contract. Example only: MNQU6.
# Do not leave a continuous symbol here for production.
DEFAULT_EXECUTION_SYMBOL=

# If Pine supplies contract_risk_dollars this fallback geometry model is unused.
MNQ_POINT_VALUE=2.0
MNQ_TICK_SIZE=0.25
MODELED_ROUND_TRIP_COST=2.90
CONSISTENCY_MIN_PROFIT_ROOM=50.0

# Safer default. CrossTrade's broker-side live position check may add latency,
# especially on a truly flat Tradovate position. Benchmark before disabling.
USE_CROSSTRADE_POSITION_GATE=true
USE_CROSSTRADE_MAX_POSITIONS_GATE=false

ACCOUNT_CONFIG_PATH=config/accounts.json
SQLITE_PATH=/data/autoprop_router.sqlite3
