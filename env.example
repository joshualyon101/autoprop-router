CROSSTRADE_BASE_URL=https://app.crosstrade.io
CROSSTRADE_TOKEN=
AUTOPROP_WEBHOOK_TOKEN=
SQLITE_PATH=/data/autoprop_router.sqlite3
ACCOUNT_CONFIG_PATH=accounts.json
AUTO_DISCOVERY=true
FUNDEDNEXT_DEFAULT_MODEL=Legacy
STATE_POLL_SECONDS=10
MAX_STATE_AGE_SECONDS=20
REQUEST_TIMEOUT_SECONDS=4
DEFAULT_EXECUTION_SYMBOL=
MNQ_POINT_VALUE=2.0
MNQ_TICK_SIZE=0.25
MODELED_ROUND_TRIP_COST=2.90
CONSISTENCY_MIN_PROFIT_ROOM=50
USE_CROSSTRADE_POSITION_GATE=true
USE_CROSSTRADE_MAX_POSITIONS_GATE=false

# FINAL-SCALE CONFIGURATION
AUTOPROP_EXECUTION_MODE=shadow
AUTOPROP_MANAGEMENT_MODE=native_atm
LIVE_MAX_QTY_PER_ACCOUNT=0
NATIVE_ATM_BREAKEVEN_AFTER_TP1=true
EXECUTION_REQUIRE_PROTECTIVE_STOP=true

# Three independent firing gates. Keep blank/false until setup is verified.
AUTOPROP_LIVE_ARM=
AUTOPROP_FULL_SCALE_ARM=
TRADINGVIEW_ALERT_CONTRACT_VERIFIED=false

# Optional canary remains supported but is not required.
CANARY_ACCOUNT_ID=
CANARY_MAX_QTY=1
